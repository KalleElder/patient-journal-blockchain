# ==========================================
# Patient Journal Blockchain
# Exempel på miljövariabler
# Kopiera denna fil till .env för lokal körning.
# Committa aldrig den riktiga .env-filen.
# ==========================================

# Server
PORT=3001
NODE_NAME=node-1

# Frontend
CLIENT_URL=http://localhost:5173

# Database
# Databasen är SQLite. DB_PATH är sökvägen till SQLite-filen, relativt
# projektroten. DB_HOST/DB_PORT/DB_USER/DB_PASSWORD används inte av SQLite
# och lämnas tomma.
DB_PATH=database/patient_journal.db
DB_HOST=localhost
DB_PORT=
DB_NAME=patient_journal
DB_USER=
DB_PASSWORD=

# Authentication
# Använd ett eget lokalt värde i riktig .env.
JWT_SECRET=change-me-locally

# P2P
# Node 1 kan exempelvis ansluta till Node 2 på port 3002.
# Flera grannar anges separerade med komma. Lämnas den tom kör noden ensam.
PEER_URL=http://localhost:3002

# Tillfällig read-only-route för att inspektera blockchainen vid utveckling
# och P2P-demo. Avstängd om värdet inte är true.
P2P_DEV_ROUTES=false

# Signering av audit-block
# Skapa ett nyckelpar med: npm run keys:generate --prefix server
# Nycklarna är base64 och läggs direkt här, inga nyckelfiler behövs.
#
# BLOCKCHAIN_PRIVATE_KEY signerar nodens egna block och får aldrig committas.
# BLOCKCHAIN_TRUSTED_KEYS är de publika nycklar noden accepterar block från,
# separerade med komma. Den egna nyckeln är alltid betrodd hos sig själv.
#
# Saknas den privata nyckeln signerar noden med ett tillfälligt par som
# försvinner vid omstart, och block från andra noder avvisas.
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_TRUSTED_KEYS=
