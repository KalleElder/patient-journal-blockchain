# ==========================================
# Patient Journal Blockchain
# Exempel på miljövariabler
# Kopiera denna fil till .env för lokal körning.
# Committa aldrig den riktiga .env-filen.
# ==========================================

# Server
PORT=3001
NODE_NAME=node-1

# Frontend
CLIENT_URL=http://localhost:5173

# Database
# Databasen är SQLite. DB_PATH är sökvägen till SQLite-filen, relativt
# projektroten. DB_HOST/DB_PORT/DB_USER/DB_PASSWORD används inte av SQLite
# och lämnas tomma.
DB_PATH=database/patient_journal.db
DB_HOST=localhost
DB_PORT=
DB_NAME=patient_journal
DB_USER=
DB_PASSWORD=

# Authentication
# Använd ett eget lokalt värde i riktig .env.
JWT_SECRET=change-me-locally

# P2P
# Node 1 kan exempelvis ansluta till Node 2 på port 3002.
PEER_URL=http://localhost:3002

# Cryptographic keys
# Används om digital signering implementeras.
PRIVATE_KEY_PATH=
PUBLIC_KEY_PATH=
